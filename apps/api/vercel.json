{
  "version": 2,
  "builds": [
    {
      "src": "api/[[...path]].ts",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "api/[[...path]].ts": {
      "includeFiles": [
        "node_modules/.prisma/client/**",
        "node_modules/@prisma/client/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/[[...path]].ts"
    }
  ]
}
